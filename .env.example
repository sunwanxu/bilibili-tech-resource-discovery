# Optional. Without this key, --analyzer auto uses a clearly-labelled heuristic baseline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional DeepSeek-compatible analyzer.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Normally configured automatically by `bhka login`.
BILIBILI_COOKIES_FILE=
# Legacy external browser-profile mode; managed login is preferred.
BILIBILI_COOKIES_FROM_BROWSER=
# Automatically recorded by `bhka login` to keep the browser session and request identity aligned.
BILIBILI_USER_AGENT=
BILIBILI_TIMEOUT_SECONDS=20
BILIBILI_RETRIES=1
BILIBILI_RATE_LIMIT_SECONDS=2.5
